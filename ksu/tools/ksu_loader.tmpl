#!/system/bin/sh
# Autonomous KSU late-load (KSU_LOADER mode). Runs in the exploit's anchor
# context (root, kernel domain, no seccomp).
export PATH=/system/bin:/system/xbin:/vendor/bin:$PATH
RD=@RUNDIR@
OUT=$RD/ksu_load.log
> $OUT
{
  echo "=== loader start ==="; id; getenforce; cut -d. -f1 /proc/uptime
  echo "=== preserve crash evidence from previous rundirs (BEFORE anything risky) ==="
  # previous runs' kmsg_cap/ksu_load are kernel-context-written and unreadable
  # to shell under enforcing; WE are kernel-domain root and can read them. Copy
  # into THIS rundir before the GC below deletes the old dirs.
  for d in $(ls -d /data/local/tmp/ksu_run_* 2>/dev/null | grep -v "@STAMP@"); do
    b=$(basename $d)
    cp $d/kmsg_cap.txt $RD/prev_kmsg_$b.txt 2>/dev/null && echo "preserved $b/kmsg_cap.txt"
    cp $d/ksu_load.log $RD/prev_load_$b.log 2>/dev/null && echo "preserved $b/ksu_load.log"
  done
  chmod -R 666 $RD/prev_* 2>/dev/null
  cp /sys/fs/pstore/* $RD/ 2>/dev/null && ls $RD/*pstore* $RD/console-ramoops* 2>/dev/null
  echo "=== runtime env (slide-derived addrs from exploit parent) ==="
  for i in $(seq 1 100); do [ -s $RD/ksu_runtime.env ] && break; sleep 1; done
  . $RD/ksu_runtime.env
  echo "COMMIT_CRED_RT=$COMMIT_CRED_RT BOOTID_CTL_RT=$BOOTID_CTL_RT BOOTID_BUF_RT=$BOOTID_BUF_RT"
  cat /proc/iomem > $RD/iomem.txt 2>/dev/null   # phys-base sampler, streamed off-device by the host watch
  echo "=== wait for parent sig_enforce walk (it runs concurrently) ==="
  sv=$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null)
  i=0
  while [ "$sv" != "N" ] && [ "$sv" != "0" ] && [ $i -lt 150 ]; do sleep 1; sv=$(cat /sys/module/module/parameters/sig_enforce 2>/dev/null); i=$((i+1)); done
  echo "sig_enforce=$sv after ${i}s"
  if [ "$sv" != "N" ] && [ "$sv" != "0" ]; then echo "sig never flipped — ABORT (EKEYREJECTED would follow)"; echo "NOTE: boot_id stays hijacked (no .ko restore) — REBOOT MANDATORY"; echo KSU_LOAD_DONE; exit 1; fi
  # HISEC antiroot: hisecd runs a "static check" + mod-sign RISK threat
  # upload seconds before every post-land hard reset. Freeze it (SIGSTOP,
  # init-safe) for the load window ONLY — a hisecd left frozen wedges Honor's
  # periodic root scan (system_server blocks ~85s on it) -> daily watchdog
  # soft-reboots. The tail of this script SIGCONTs it again.
  if [ @FREEZE_HISECD@ = 1 ]; then hp=$(pidof hisecd); [ -n "$hp" ] && kill -STOP $hp && echo "hisecd FROZEN pid=$hp"; fi
  echo "=== kptr dance + fake kallsyms (PREPEND commit_creds) ==="
  KR=$(cat /proc/sys/kernel/kptr_restrict); echo "kptr was=$KR"
  echo 0 > /proc/sys/kernel/kptr_restrict
  echo "${COMMIT_CRED_RT#0x} T commit_creds" > $RD/kallsyms_add.txt
  cat /proc/kallsyms > $RD/real_ks.tmp
  cat $RD/kallsyms_add.txt $RD/real_ks.tmp > $RD/fake_kallsyms
  echo "addendum: $(cat $RD/kallsyms_add.txt) (fake lines=$(wc -l < $RD/fake_kallsyms))"
  # abort-path cleanup: every exit AFTER this point must thaw hisecd and
  # restore sig_enforce / kptr_restrict. sig_enforce was flipped to 0 by the
  # parent route; sysfs accepts writing 1 back.
  if ! mount --bind $RD/fake_kallsyms /proc/kallsyms; then
    echo "bind-mount FAIL"
    echo $KR > /proc/sys/kernel/kptr_restrict 2>/dev/null
    echo 1 > /sys/module/module/parameters/sig_enforce 2>/dev/null
    [ -n "$hp" ] && kill -CONT $hp 2>/dev/null && echo "hisecd thawed on abort"
    echo "NOTE: boot_id stays hijacked (no .ko restore) — REBOOT MANDATORY"
    echo KSU_LOAD_DONE; exit 1
  fi
  echo "=== policy injection (single shot, before module load) ==="
  # Snapshot the PRISTINE policy before any rule goes in: the .ko installs it
  # as the selinux_hide backup (it can't create one itself — see
  # selinux-hide-backup.patch). Must precede the magiskpolicy injection below.
  cat /sys/fs/selinux/policy > $RD/pristine_policy 2>/dev/null \
    && echo "pristine policy snapshot: $(wc -c < $RD/pristine_policy) bytes"
  $RD/magiskpolicy --apply $RD/ksu_rules --live 2>&1
  echo "magiskpolicy exit=$?"
  ctx=$(/system/bin/sh -c 'cat /proc/self/attr/current' 2>/dev/null)
  if [ -z "$ctx" ]; then
    echo "HEALTH GATE FAILED after policy injection (attr/current unresolvable) — ABORT before module load"
    umount /proc/kallsyms 2>/dev/null; echo $KR > /proc/sys/kernel/kptr_restrict 2>/dev/null
    echo 1 > /sys/module/module/parameters/sig_enforce 2>/dev/null
    [ -n "$hp" ] && kill -CONT $hp 2>/dev/null && echo "hisecd thawed on abort"
    echo "NOTE: boot_id stays hijacked (no .ko restore) — REBOOT MANDATORY"
    echo KSU_LOAD_DONE; exit 1
  fi
  echo "policy injected OK (ctx=$ctx)"
  echo "=== load_ko (init_module flags=0) ==="
  PO=$(cat /proc/sys/kernel/panic_on_oops 2>/dev/null); PO=${PO:-1}
  echo "panic_on_oops(before)=$PO"
  echo 0 > /proc/sys/kernel/panic_on_oops 2>&1
  $RD/kmsg_dumper $RD/kmsg_cap.txt &
  KMSG_PID=$!
  sleep 1
  if [ @ALLOW_SHELL@ = 1 ]; then KSU_PARAMS="allow_shell=1 "; else KSU_PARAMS=""; fi
  KSU_PARAMS="${KSU_PARAMS}bootid_ctl=$BOOTID_CTL_RT bootid_buf=$BOOTID_BUF_RT"
  [ -s $RD/pristine_policy ] && KSU_PARAMS="$KSU_PARAMS pristine_policy=$RD/pristine_policy"
  echo "ksu params: $KSU_PARAMS"
  $RD/load_ko $RD/kernelsu.ko "$KSU_PARAMS" > $RD/loadko_result.log 2>&1
  echo "load_ko_exit=$?"
  sync; sleep 2
  grep -i kernelsu /proc/modules 2>&1 || echo "(no kernelsu in /proc/modules)"
  echo "=== loadko_result.log ==="; cat $RD/loadko_result.log 2>&1
  echo "=== KSU userspace bring-up ==="
  if grep -qi kernelsu /proc/modules && [ @STAGES@ = 1 ]; then
    # ZygiskNext must not come up on a late (post-boot) KSU load — it wedges
    # the session. Disable it before the ksud stages; the hotreboot module
    # re-enables and rebuilds it after its soft reboot.
    [ -d /data/adb/modules/zygisksu ] && touch /data/adb/modules/zygisksu/disable
    $RD/ksud post-fs-data 2>&1; echo "pfd=$?"
    $RD/ksud services 2>&1; echo "svc=$?"
    $RD/ksud boot-completed 2>&1; echo "bc=$?"
    $RD/ksud install 2>&1; echo "install=$?"
    ls -la /data/adb/ksud 2>&1
    # CN builds: Honor's parseReadAppsPermission (framework PackageParser) calls
    # ActivityManager.isSystemReady() -> LocalServices lookup that only exists
    # in system_server. LSPosed's daemon parses module APKs in its own process,
    # so every parse of an APK requesting Honor's GET_INSTALLED_APPS permission
    # dies with NPE -> "failed to parse ... Failed to read manifest" -> module
    # never hooks (Thanox etc). Flip the region prop so HnPackageUtils'
    # isChinaVersion() short-circuits before that call. Runtime property-area
    # change only — no partition writes, restored by reboot; user locale comes
    # from Settings and is unaffected. Needs redoing every session (here).
    $RD/ksud resetprop ro.product.locale.region US 2>&1 && echo "locale.region flipped (LSPosed daemon parse fix)"
    # ADB root: the .ko's execve hook injects LD_PRELOAD only into adbd execs
    # that happen AFTER the feature is armed (ksud pfd sets it from
    # .feature_config just above). adbd has been running since boot, so the
    # armed hook never fires for it — restart adbd now; the fresh exec picks
    # up libadbroot.so and adb comes up rooted (survives all later soft
    # reboots). Without this the manager toggle must be re-flipped after every
    # re-jailbreak just to bounce adbd.
    setprop ctl.restart adbd; echo "ctl.restart adbd rc=$?"
  else
    echo "module missing or KSU_STAGES=0 — skipping stages"
    grep -qi kernelsu /proc/modules || echo "NOTE: no .ko loaded -> boot_id stays hijacked (no restore) — REBOOT MANDATORY"
  fi
  echo "=== restore hardening knobs (BEFORE enforce!) ==="
  echo $PO > /proc/sys/kernel/panic_on_oops 2>&1 && echo -n "panic_on_oops=" && cat /proc/sys/kernel/panic_on_oops 2>&1
  echo 1 > /sys/module/module/parameters/sig_enforce 2>&1 && echo -n "sig_enforce=" && cat /sys/module/module/parameters/sig_enforce 2>&1
  umount /proc/kallsyms 2>&1 && echo "umount OK"
  echo $KR > /proc/sys/kernel/kptr_restrict 2>&1 && echo "kptr restored=$KR"
  echo "=== GC stale poisoned inodes + old rundirs ==="
  rm -f /data/local/tmp/{diag.sh,gl_exploit,gl_sysctl.log,kallsyms_add.txt,kernelsu.ko,kernelsu_neutered.ko,kmsg_dumper,ksu.rules,ksu_dev_inject.sh,ksu_dev_loader.sh,ksud,ksud_help.txt,load_ko,loadko_result.log,magiskpolicy,neut.sh,neut_result.log,policy_after_full.bin,result.done,ksu_rules} 2>&1
  ls -d /data/local/tmp/ksu_run_* 2>/dev/null | grep -v "@STAMP@" | while read d; do rm -rf "$d"; done
  echo "GC done"
  echo "=== process cleanup (immediate) ==="
  pkill -9 -f 'gl_ex[p]loit' 2>/dev/null; echo "exploit remnants swept"
  kill $KMSG_PID 2>/dev/null; pkill -f ksucmdwatch 2>/dev/null
  echo "kmsg_dumper + cmd watcher stopped"
  echo "=== thaw hisecd (a frozen hisecd wedges Honor's periodic ==="
  echo "=== root scan -> daily system_server watchdog soft-reboots) ==="
  if [ @FREEZE_HISECD@ = 1 ] && [ -n "$hp" ]; then
    kill -CONT $hp 2>/dev/null && echo "hisecd THAWED pid=$hp"
  fi
  : > ${RD%/*}/result.done 2>/dev/null   # end-marker for host-side poll loops (written pre-enforce, while kernel-domain opens still work)
  if grep -qi kernelsu /proc/modules && [ @ENFORCE@ = 1 ]; then
    echo "=== enforce SELinux (ABSOLUTE LAST: builtins only from here) ==="
    echo 1 > /sys/fs/selinux/enforce 2>&1
    read EBACK < /sys/fs/selinux/enforce 2>&1; echo "enforce readback=$EBACK"
  else
    echo "KSU_ENFORCE=0 or module missing — leaving permissive"
  fi
  echo "=== final ==="; grep -i kernelsu /proc/modules 2>&1; cut -d. -f1 /proc/uptime
} >> $OUT 2>&1
echo "KSU_LOAD_DONE $OUT"
