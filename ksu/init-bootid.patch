 module_param(allow_shell, bool, 0);
 
+// H80GT: the GhostLock sysctl route hijacks boot_id's ctl_table.data as its
+// arbitrary R/W channel and never restores it to buffer+0, so after the
+// chain /proc/sys/kernel/random/boot_id reads VOLATILE kernel memory.
+// libcutils builds /dev/ashmem<boot_id> at every app start -> ENOENT ->
+// fallback /dev/ashmem is denied for app domains -> every app crashes, and a
+// userspace mknod chase cannot work (the value keeps changing). Kernel-space
+// fix: point ctl_table.data back at the true sysctl_bootid buffer (ueventd
+// already created /dev/ashmem<true-uuid> at boot). Both are statics stripped
+// from kallsyms, so the loader passes link+slide as module params.
+static unsigned long bootid_ctl;
+module_param(bootid_ctl, ulong, 0);
+static unsigned long bootid_buf;
+module_param(bootid_buf, ulong, 0);
+
+static void __init restore_bootid(void)
+{
+    if (!bootid_ctl || !bootid_buf)
+        return;
+    // struct ctl_table: procname @ +0, data @ +8 (device-verified layout)
+    *(void **)(bootid_ctl + 8) = (void *)bootid_buf;
+    pr_info("H80GT: boot_id ctl.data restored (ctl=0x%lx buf=0x%lx)\n",
+            bootid_ctl, bootid_buf);
+}
+
 bool ksu_no_custom_rc = false;
 module_param_named(norc, ksu_no_custom_rc, bool, 0);
 
@@ -140,7 +164,16 @@ int __init kernelsu_init(void)
     if (ksu_late_loaded) {
         pr_info("late load mode, skipping kprobe hooks\n");
 
-        apply_kernelsu_rules();
+        // H80GT: NEVER call apply_kernelsu_rules() on a late load: it dup's
+        // the live policydb, patches the copy, rcu_assign_pointer()s it in and
+        // destroys the old policy, but NEVER calls security_load_policy() —
+        // so sidtab_convert() never runs and every running SID keeps a
+        // context computed against the destroyed policydb (device-verified:
+        // attr/current unreadable, servicemanager broken system-wide, a soft
+        // reboot does not heal). The same rules are instead injected BEFORE
+        // this module loads via magiskpolicy --live (device-verified clean).
+        pr_info("H80GT: not touching live sepolicy (rules pre-injected)\n");
+        restore_bootid();
         cache_sid();
         setup_ksu_cred();
 
