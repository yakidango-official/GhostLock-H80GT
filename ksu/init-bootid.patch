diff --git a/kernel/core/init.c b/kernel/core/init.c
index e6e1b684..8bb961e2 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -80,6 +80,30 @@ bool allow_shell = false;
 #endif
 module_param(allow_shell, bool, 0);
 
+// the GhostLock sysctl route hijacks boot_id's ctl_table.data as its
+// arbitrary R/W channel and never restores it to buffer+0, so after the
+// chain /proc/sys/kernel/random/boot_id reads VOLATILE kernel memory.
+// libcutils builds /dev/ashmem<boot_id> at every app start -> ENOENT ->
+// fallback /dev/ashmem is denied for app domains -> every app crashes, and a
+// userspace mknod workaround cannot work (the value keeps changing). Kernel-space
+// fix: point ctl_table.data back at the true sysctl_bootid buffer (ueventd
+// already created /dev/ashmem<true-uuid> at boot). Both are statics stripped
+// from kallsyms, so the loader passes link+slide as module params.
+static unsigned long bootid_ctl;
+module_param(bootid_ctl, ulong, 0);
+static unsigned long bootid_buf;
+module_param(bootid_buf, ulong, 0);
+
+static void __init restore_bootid(void)
+{
+    if (!bootid_ctl || !bootid_buf)
+        return;
+    // struct ctl_table: procname @ +0, data @ +8 (device-verified layout)
+    *(void **)(bootid_ctl + 8) = (void *)bootid_buf;
+    pr_info("boot_id ctl.data restored (ctl=0x%lx buf=0x%lx)\n",
+            bootid_ctl, bootid_buf);
+}
+
 bool ksu_no_custom_rc = false;
 module_param_named(norc, ksu_no_custom_rc, bool, 0);
 
@@ -140,7 +164,16 @@ int __init kernelsu_init(void)
     if (ksu_late_loaded) {
         pr_info("late load mode, skipping kprobe hooks\n");
 
-        apply_kernelsu_rules();
+        // NEVER call apply_kernelsu_rules() on a late load: the same rules
+        // are already injected BEFORE this module loads via magiskpolicy
+        // --live (device-verified clean), so a second application here is
+        // redundant. (An earlier revision of this comment blamed the
+        // dup/swap-and-destroy itself for a device-verified servicemanager
+        // breakage; that breakage was later root-caused to the exploit's
+        // own permissive write clearing selinux_state.initialized@+2, and
+        // the swap path is exonerated.)
+        pr_info("not touching live sepolicy (rules pre-injected)\n");
+        restore_bootid();
         cache_sid();
         setup_ksu_cred();
 
@@ -161,9 +194,10 @@ int __init kernelsu_init(void)
         ksu_boot_completed = true;
         track_throne(false);
 
+        // do NOT setenforce(true) here. Enforcing is flipped manually
+        // as the LAST step of the load flow, after userspace is set up.
         if (!getenforce()) {
